FROM python:3.10-slim

WORKDIR /app

COPY requirements/dashboard.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY dashboard/app.py ./app.py
COPY dashboard/dashboard.html dashboard/login.html ./
COPY webchat/*.html ./
COPY observability/ ./observability/

EXPOSE 5001

# 2 workers is enough for an internal dashboard; scale up with GUNICORN_WORKERS env var
CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:5001 --workers ${GUNICORN_WORKERS:-2} --timeout 60 --access-logfile - app:app"]
