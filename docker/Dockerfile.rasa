FROM rasa/rasa:3.6.20-full

USER root

# psycopg2 for the SQL tracker store
RUN pip install --no-cache-dir psycopg2-binary==2.9.*

WORKDIR /app

COPY config.yml domain.yml credentials.yml endpoints.yml ./
COPY data/   ./data/
COPY models/ ./models/

USER 1001

EXPOSE 5005

CMD ["run", "--enable-api", "--cors", "*", "--port", "5005"]
