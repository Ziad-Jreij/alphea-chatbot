# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot

# Rasa tracker store (used in endpoints.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatbot
DB_USER=chatbot
DB_PASSWORD=chatbot

# ── Dashboard Auth ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme

# ── Service URLs ──────────────────────────────────────────────────────────────
# URL that the Rasa action server uses to push state to the dashboard
DASHBOARD_BACKEND_URL=http://localhost:5001

# ── Dashboard server ──────────────────────────────────────────────────────────
DASHBOARD_PORT=5001
FLASK_DEBUG=false
GUNICORN_WORKERS=2
# Comma-separated list of allowed origins (use * for development only)
CORS_ORIGINS=*

# ── Rasa ──────────────────────────────────────────────────────────────────────
RASA_ACTION_ENDPOINT=http://localhost:5055/webhook
# SocketIO CORS: restrict to your frontend origin(s) in production.
# Example: RASA_CORS_ORIGINS=https://chat.yourcompany.com
RASA_CORS_ORIGINS=*

# ── Monitoring (Grafana / Prometheus) ────────────────────────────────────────
# SECURITY: Prometheus (9090) and Grafana (3000) must NOT be exposed publicly.
# Bind them to an internal network or reverse-proxy with auth in production.
# /metrics on the dashboard is intentionally unauthenticated for Prometheus.
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# ── GPU Acceleration ─────────────────────────────────────────────────────────
# Controls whether AI models (emotion, criticality) use a GPU.
#   auto  — use GPU if CUDA is available, otherwise fall back to CPU (default)
#   true  — require GPU; the actions container will fail to start without one
#   false — always run on CPU even if a GPU is present
GPU_ENABLED=auto

# ── Order Integration ─────────────────────────────────────────────────────────
# Set to "mock" (default) for demo/development, or "rest" for a real backend.
ORDER_PROVIDER=mock

# Required when ORDER_PROVIDER=rest
# ORDER_API_BASE_URL=https://api.yourstore.com/v1
# ORDER_API_KEY=your-api-key-here
# ORDER_API_TIMEOUT=10
