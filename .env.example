# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot

# Rasa tracker store (used in endpoints.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatbot
DB_USER=chatbot
DB_PASSWORD=chatbot

# ── Secrets ───────────────────────────────────────────────────────────────────
# REQUIRED. The dashboard refuses to start while these are empty or defaults.
# Generate each one with:  openssl rand -hex 32
JWT_SECRET_KEY=
# Shared secret the action server sends when pushing session state
DASHBOARD_INGEST_TOKEN=
# Protects the Rasa HTTP API (/conversations, /model, ...) on port 5005
RASA_AUTH_TOKEN=

# ── Dashboard Auth ────────────────────────────────────────────────────────────
DASHBOARD_USERNAME=admin
# At least 12 characters
DASHBOARD_PASSWORD=

# ── Service URLs ──────────────────────────────────────────────────────────────
# URL that the Rasa action server uses to push state to the dashboard
DASHBOARD_BACKEND_URL=http://localhost:5001

# ── Dashboard server ──────────────────────────────────────────────────────────
DASHBOARD_PORT=5001
FLASK_DEBUG=false
GUNICORN_WORKERS=2
# Comma-separated list of allowed origins (use * for development only)
CORS_ORIGINS=*
# Number of reverse proxies (nginx, load balancer) in front of the dashboard.
# Only then is X-Forwarded-For trusted for rate limiting. Leave 0 if none.
TRUSTED_PROXY_COUNT=0
# Rate-limit counter store. docker-compose sets redis://redis:6379/0;
# memory:// is per-process and only suitable for local development.
# RATELIMIT_STORAGE_URI=memory://

# ── Rasa ──────────────────────────────────────────────────────────────────────
RASA_ACTION_ENDPOINT=http://localhost:5055/webhook
# SocketIO CORS: restrict to your frontend origin(s) in production.
# Example: RASA_CORS_ORIGINS=https://chat.yourcompany.com
RASA_CORS_ORIGINS=*

# ── Monitoring (Grafana / Prometheus) ────────────────────────────────────────
# SECURITY: Prometheus (9090) and Grafana (3000) must NOT be exposed publicly.
# Bind them to an internal network or reverse-proxy with auth in production.
# /metrics on the dashboard is intentionally unauthenticated for Prometheus.
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# ── GPU Acceleration ─────────────────────────────────────────────────────────
# Controls whether AI models (emotion, criticality) use a GPU.
#   auto  — use GPU if CUDA is available, otherwise fall back to CPU (default)
#   true  — require GPU; the actions container will fail to start without one
#   false — always run on CPU even if a GPU is present
GPU_ENABLED=auto
# torch wheel index used when building rasa-actions. GPU builds need CUDA wheels:
#   TORCH_INDEX=https://download.pytorch.org/whl/cu128
# TORCH_INDEX=https://download.pytorch.org/whl/cpu
# Zero-shot model used for criticality scoring. CPU-friendly alternative:
#   MoritzLaurer/deberta-v3-xsmall-zeroshot-v1.1-all-33
CRITICALITY_MODEL=MoritzLaurer/deberta-v3-base-zeroshot-v2.0
# Load all models before the action server accepts requests (recommended).
PRELOAD_MODELS=true

# ── Order Integration ─────────────────────────────────────────────────────────
# Set to "mock" (default) for demo/development, or "rest" for a real backend.
ORDER_PROVIDER=mock

# Required when ORDER_PROVIDER=rest
# ORDER_API_BASE_URL=https://api.yourstore.com/v1
# ORDER_API_KEY=your-api-key-here
# ORDER_API_TIMEOUT=10
